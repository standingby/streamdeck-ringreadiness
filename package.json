{
  "name": "streamdeck-oura",
  "version": "0.1.0",
  "private": true,
  "description": "Personal Stream Deck+ plugin showing Oura Ring metrics",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.rotte.oura\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "streamdeck validate com.rotte.oura.sdPlugin",
    "link": "streamdeck link com.rotte.oura.sdPlugin",
    "restart": "streamdeck restart com.rotte.oura"
  },
  "dependencies": {
    "@elgato/streamdeck": "2.1.2"
  },
  "devDependencies": {
    "@elgato/cli": "1.10.4",
    "@rollup/plugin-commonjs": "28.0.9",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.2",
    "@rollup/plugin-typescript": "12.3.1",
    "@types/node": "24.19.2",
    "rollup": "4.66.0",
    "tslib": "2.9.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
