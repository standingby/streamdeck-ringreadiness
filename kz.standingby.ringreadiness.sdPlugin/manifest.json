{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"Name": "Ring Readiness",
	"Version": "0.1.0.0",
	"Author": "standingby",
	"Description": "Readiness, sleep, activity, stress, HRV and heart rate from your Oura Ring on Stream Deck keys and Stream Deck+ dials. Not affiliated with or endorsed by Oura.",
	"URL": "https://github.com/standingby/ringreadiness",
	"UUID": "kz.standingby.ringreadiness",
	"Icon": "imgs/plugin/icon",
	"Category": "Ring Readiness",
	"CategoryIcon": "imgs/plugin/category",
	"CodePath": "bin/plugin.js",
	"SDKVersion": 2,
	"Software": {
		"MinimumVersion": "6.9"
	},
	"OS": [
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "20"
	},
	"Actions": [
		{
			"Name": "Ring Metric",
			"UUID": "kz.standingby.ringreadiness.metric",
			"Icon": "imgs/actions/metric",
			"Tooltip": "One Oura metric. Press: next metric. Hold: refresh. Dial: rotate to browse days.",
			"PropertyInspectorPath": "ui/metric.html",
			"Controllers": [
				"Keypad",
				"Encoder"
			],
			"Encoder": {
				"layout": "layouts/strip.json",
				"TriggerDescription": {
					"Rotate": "Browse days",
					"Push": "Next metric (hold: today and refresh)",
					"Touch": "Next metric (hold: refresh)"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/metric",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Trend Chart",
			"UUID": "kz.standingby.ringreadiness.chart",
			"Icon": "imgs/actions/chart",
			"Tooltip": "7 or 30 day chart of an Oura metric. Press: next metric. Hold: refresh.",
			"PropertyInspectorPath": "ui/chart.html",
			"Controllers": [
				"Keypad",
				"Encoder"
			],
			"Encoder": {
				"layout": "layouts/strip.json",
				"TriggerDescription": {
					"Rotate": "Select day",
					"Push": "Next metric (hold: 7 / 30 days)",
					"Touch": "Next metric (hold: refresh)"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/chart",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Day Summary",
			"UUID": "kz.standingby.ringreadiness.summary",
			"Icon": "imgs/actions/summary",
			"Tooltip": "Readiness, Sleep and Activity at a glance. Press: today and refresh.",
			"PropertyInspectorPath": "ui/summary.html",
			"Controllers": [
				"Keypad",
				"Encoder"
			],
			"Encoder": {
				"layout": "layouts/strip.json",
				"TriggerDescription": {
					"Rotate": "Browse days",
					"Push": "Today and refresh",
					"Touch": "Refresh"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/summary",
					"ShowTitle": false
				}
			]
		}
	]
}